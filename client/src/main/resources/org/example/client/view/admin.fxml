<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.client.controller.AdminController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="← Quay lại" onAction="#onBack"/>
        <Label text="Quản trị người dùng" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="toggleButton" text="Khóa / Mở khóa" onAction="#onToggle"/>
        <Button text="Làm mới" onAction="#onRefresh"/>
        <Label fx:id="messageLabel" wrapText="true"/>
    </HBox>

    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="nameColumn" text="Tên đăng nhập" prefWidth="200"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="260"/>
            <TableColumn fx:id="roleColumn" text="Vai trò" prefWidth="100"/>
            <TableColumn fx:id="activeColumn" text="Trạng thái" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>