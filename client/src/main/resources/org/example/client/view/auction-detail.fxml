<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.client.controller.AuctionDetailController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="← Quay lại" onAction="#onBack"/>
        <Label fx:id="titleLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    </HBox>

    <Label fx:id="descriptionLabel" wrapText="true"/>
    <Label fx:id="statusLabel"/>
    <Label fx:id="priceLabel" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label fx:id="leaderLabel"/>
    <Label fx:id="countdownLabel" style="-fx-font-size: 18px; -fx-text-fill: #c0392b;"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="bidField" promptText="Nhập giá (đồng)" prefWidth="220"/>
        <Button fx:id="bidButton" text="Đặt giá" onAction="#onBid"/>
    </HBox>
    <Label fx:id="messageLabel" wrapText="true"/>

    <Label text="Lịch sử đặt giá" style="-fx-font-weight: bold;"/>
    <ListView fx:id="bidList" prefHeight="200"/>
</VBox>