<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" maxWidth="520" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.client.controller.CreateAuctionController">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="← Quay lại" onAction="#onBack"/>
        <Label text="Tạo phiên đấu giá" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    </HBox>

    <TextField fx:id="nameField" promptText="Tên sản phẩm"/>
    <TextArea fx:id="descriptionArea" promptText="Mô tả" prefRowCount="3" wrapText="true"/>
    <HBox spacing="8">
        <ComboBox fx:id="typeBox" prefWidth="220"/>
        <ComboBox fx:id="conditionBox" prefWidth="220"/>
    </HBox>
    <TextField fx:id="priceField" promptText="Giá khởi điểm (đồng)"/>

    <Label text="Thời gian bắt đầu"/>
    <HBox spacing="8">
        <DatePicker fx:id="startDate"/>
        <TextField fx:id="startTime" promptText="HH:mm" prefWidth="80"/>
    </HBox>
    <Label text="Thời gian kết thúc"/>
    <HBox spacing="8">
        <DatePicker fx:id="endDate"/>
        <TextField fx:id="endTime" promptText="HH:mm" prefWidth="80"/>
    </HBox>

    <Label fx:id="messageLabel" wrapText="true"/>
    <Button fx:id="createButton" text="Tạo phiên" maxWidth="Infinity" onAction="#onCreate"/>
</VBox>