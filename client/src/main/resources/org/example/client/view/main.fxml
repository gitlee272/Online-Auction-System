<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.client.controller.MainController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Phiên đấu giá" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel"/>
        <Button fx:id="createButton" text="+ Tạo phiên" onAction="#onCreateAuction"/>
        <Button text="Đăng xuất" onAction="#onLogout"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm theo tên sản phẩm" prefWidth="260"/>
        <ComboBox fx:id="statusFilter" prefWidth="160"/>
        <Button text="Làm mới" onAction="#onRefresh"/>
        <Label fx:id="statusLabel" style="-fx-text-fill: gray;"/>
    </HBox>

    <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Sản phẩm" prefWidth="340"/>
            <TableColumn fx:id="priceColumn" text="Giá hiện tại" prefWidth="180"/>
            <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="120"/>
            <TableColumn fx:id="endColumn" text="Kết thúc" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>